# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Fruitfy PIX
FRUITFY_API_TOKEN="seu_token_fruitfy"
FRUITFY_STORE_ID="uuid-da-loja"
FRUITFY_PRODUCT_ID="uuid-do-produto"
FRUITFY_API_BASE_URL="https://api.fruitfy.io"
API_PORT="3002"

# Utmify — Integrações → Webhooks → Credenciais de API (opcional, CAPI)
UTMIFY_API_TOKEN="sua_credencial_utmify"
